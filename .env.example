# ── Twitter / X (via RapidAPI Twitter135) ──────────────────────────────────
# Subscribe at https://rapidapi.com/twitter135 → copy your key from any endpoint example.
RAPIDAPI_KEY=your_rapidapi_key_here

# ── Proxycurl (LinkedIn enrichment) ────────────────────────────────────────
# Sign up at https://nubela.co/proxycurl → Dashboard → API Key
PROXYCURL_API_KEY=

# ── SerpAPI (Google Dorking) ────────────────────────────────────────────────
# Sign up at https://serpapi.com → Dashboard → Your API Key
SERPAPI_KEY=

# Set to "true" only when you want the scheduler to actively consume SerpAPI quota.
# Default: false (safe). Can be toggled at runtime via POST /workers/google-dorker/enable
GOOGLE_DORKER_ENABLED=false

# Cross-platform profile lookup: finds LinkedIn + Twitter for HN/PH discoveries.
# Each run costs up to 2 SerpAPI credits per founder (max 25 founders/run).
SOCIAL_LOOKUP_ENABLED=false

# ── ProductHunt ─────────────────────────────────────────────────────────────
# Go to https://www.producthunt.com/v2/oauth/applications → New Application
# Use Client Secret as the API token (server-side OAuth2 token).
PRODUCTHUNT_API_TOKEN=

# ── Database ─────────────────────────────────────────────────────────────────
# SQLite (default, no config needed):
DATABASE_URL=sqlite:///founders.db
# PostgreSQL (swap for production):
# DATABASE_URL=postgresql://user:password@host:5432/vcdb

# ── App settings ─────────────────────────────────────────────────────────────
# Minimum score to return from GET /founders
MIN_SCORE_THRESHOLD=40