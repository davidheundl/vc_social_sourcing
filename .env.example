# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/vc_sourcing
# SQLite fallback (local dev only, no config needed):
# DATABASE_URL=sqlite:///founders.db

# ── Anthropic (optional LLM classification — off by default) ──────────────────
ANTHROPIC_API_KEY=

# ── Twitter / X (Tweepy bearer token via developer.twitter.com) ───────────────
RAPIDAPI_KEY=

# ── Proxycurl (LinkedIn enrichment — nubela.co/proxycurl) ─────────────────────
PROXYCURL_API_KEY=

# ── SerpAPI (Google Dorking + Social Lookup — serpapi.com) ────────────────────
SERPAPI_KEY=

# ── ProductHunt (producthunt.com/v2/oauth/applications → Client Secret) ───────
PRODUCTHUNT_API_TOKEN=

# ── Worker feature flags ──────────────────────────────────────────────────────
# Set to "true" only when you want the scheduler to actively consume SerpAPI quota.
GOOGLE_DORKER_ENABLED=false
# Cross-platform profile lookup for HN/PH founders (up to 2 SerpAPI credits/founder).
SOCIAL_LOOKUP_ENABLED=false

# ── App settings ──────────────────────────────────────────────────────────────
MIN_SCORE_THRESHOLD=40
